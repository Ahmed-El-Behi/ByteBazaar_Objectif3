# Copier ce fichier en .env puis renseigner les valeurs.

# PostgreSQL : utilisateur, mot de passe, hôte, port et nom de la base
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/bytebazaar?schema=public"

# Clé de signature des sessions : une longue chaîne aléatoire, par exemple le résultat de
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Adresse du site autorisée par CORS (plusieurs : séparées par des virgules)
FRONTEND_URL="http://localhost:4200"

# Port de l'API (3000 par défaut)
PORT=3000

# Reverse proxy à croire pour X-Forwarded-For (IP réelle des visiteurs, limites de tentatives) :
# « loopback » par défaut, c'est-à-dire un proxy sur la même machine
TRUST_PROXY="loopback"
